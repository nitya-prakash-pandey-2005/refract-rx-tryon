# Copy to .env and fill in. Never commit .env.
# YouCam API key (India: https://yce.makeupar.com/api-console/en/api-keys/ · elsewhere: yce.perfectcorp.com)
YOUCAM_API_KEY=
# India-reachable host (perfectcorp.com hosts are blocked on some Indian ISPs)
YOUCAM_BASE=https://yce-api-01.makeupar.com
# Optional: Claude powers the "Ask Refract" agent. Without a key it runs a built-in planner.
ANTHROPIC_API_KEY=
# Set RECORD=1 to save real YouCam responses to public/replay/ for the judge demo.
RECORD=
PORT=5190
# Daily cap on live YouCam units for a public demo (default 400)
YOUCAM_DAILY_UNITS=400
